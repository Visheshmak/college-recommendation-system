# Email Configuration
# Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For other providers, use their SMTP settings

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=college-recommendation@example.com

# LLM Configuration (Optional)
# Choose between: groq (free), openai (paid), ollama (local free)

USE_LLM=false
LLM_PROVIDER=groq
LLM_MODEL=mixtral-8x7b-32768

# Get your API keys:
# Groq (Free): https://console.groq.com/keys
# OpenAI (Paid): https://platform.openai.com/api-keys
# Ollama (Local): Install from https://ollama.ai

LLM_API_KEY=your-api-key-here

# For Ollama (local):
OLLAMA_URL=http://localhost:11434/api/generate

# MongoDB Configuration (if needed)
# MONGODB_URI=mongodb://localhost:27017

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=student_secret_key
